# Copy to .env for local preview. No secrets belong in this file.
# APP-003: canonical site URL (approval_required). Placeholder used only in preview.
SITE_URL=https://htv399.github.io/hamiltontaveras.github.io
# Deployment sub-path for GitHub Pages project sites. "/" for user/org pages.
BASE_PATH=/hamiltontaveras.github.io
# APP-001: default language, approval_required. Placeholder "en" used only in preview.
DEFAULT_LANGUAGE=en
# APP-005: contact channel, approval_required. "pending" blocks production contact publishing.
CONTACT_MODE=pending
# APP-009: analytics, approval_required. Must stay "off" until approved.
ANALYTICS_MODE=off
# preview | production. Production build fails on any placeholder:true content.
SITE_ENV=preview
