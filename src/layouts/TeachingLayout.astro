---
// REP-LAYOUT-005. Course, Week and Material pages: publication feel, not
// an LMS chrome.
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  language: "en" | "es";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, path, language, jsonLd } = Astro.props;
---
<BaseLayout title={title} description={description} path={path} language={language} jsonLd={jsonLd}>
  <article class="shell section-standard">
    <slot />
  </article>
</BaseLayout>
