---
// REP-LAYOUT-001. Shared shell: landmarks, skip link, header, footer and
// the required SEO surface. Every page renders through this layout.
import SiteHeader from "../components/shell/SiteHeader.astro";
import SiteFooter from "../components/shell/SiteFooter.astro";
import MetaTags from "../components/seo/MetaTags.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { t } from "../i18n/ui";
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/typography.css";
import "../styles/base.css";
import "../styles/data.css";
import "../styles/utilities.css";
import "katex/dist/katex.min.css";
import { reciprocalLanguageAlternative } from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  path: string;
  canonicalPath?: string;
  language: "en" | "es";
  headerVariant?: "transparent_on_navy_hero" | "solid_paper" | "compact";
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}
const {
  title,
  description,
  path,
  canonicalPath,
  language,
  headerVariant = "solid_paper",
  ogImage,
  noindex,
  jsonLd,
  bodyClass
} = Astro.props;
const strings = t(language);
const alternateLanguage = language === "en" ? "es" : "en";
const alternatePath = reciprocalLanguageAlternative(path, language);
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <MetaTags title={title} description={description} path={path} canonicalPath={canonicalPath} language={language} ogImage={ogImage} noindex={noindex} />
    {alternatePath && <link rel="alternate" hreflang={alternateLanguage} href={`${import.meta.env.SITE}${alternatePath}`} />}
    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a href="#content" class="skip-link">{strings.skipToContent}</a>
    <div data-pagefind-ignore="all">
      <SiteHeader currentPath={path} language={language} variant={headerVariant} />
    </div>
    <main id="content" data-pagefind-body>
      {/* CMP-SEARCH / TECH-SEARCH-001 language_scopes: Pagefind only
          exposes a filterable facet for attributes tagged with
          data-pagefind-filter; this is what src/components/search/Search.tsx
          scopes its query to via filters:{language}. */}
      <span class="visually-hidden" data-pagefind-filter="language">{language}</span>
      <slot />
    </main>
    <div data-pagefind-ignore="all">
      <SiteFooter language={language} />
    </div>
  </body>
</html>
