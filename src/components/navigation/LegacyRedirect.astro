---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";
interface Props { from: string; to: string; label?: string }
const { from, to, label = "Continue to the current page" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}${to}`;
---
<BaseLayout title={`Page moved: ${from} — ${siteConfig.name}`} description="This route has moved within CaribbeanQuant." path={from} canonicalPath={to} language="en" noindex={true}>
  <meta slot="head" http-equiv="refresh" content={`0;url=${target}`} />
  <section class="shell section-standard reading-column" style="margin-inline:auto;" data-pagefind-ignore>
    <p class="text-micro">Route updated</p>
    <h1>This page has moved</h1>
    <p class="text-body-l">CaribbeanQuant now organizes this material under its current platform structure.</p>
    <p><a href={to}>{label} →</a></p>
  </section>
  <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
</BaseLayout>
