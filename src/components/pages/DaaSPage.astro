---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig, type Language } from "../../config/site";
interface Props { language: Language }
const { language } = Astro.props;
const es = language === "es";
const prefix = es ? "/es" : "";
const path = `${prefix}/daas-platform/`;
const copy = es ? {
  title:"Plataforma DaaS", lead:"Contenido bajo demanda.", intro:"Centraliza los datos que necesitas para mejorar la productividad de tu empresa o institución.", documented:"Datos documentados", documentedText:"Conjuntos de datos limpios y documentados, organizados mediante un catálogo de datos estructurado.", ready:"Datos listos para análisis", readyText:"Datos almacenados, integrados y transformados para análisis sectoriales bajo demanda.", coverage:"Cobertura sectorial", coverageText:"Macroeconomía, banca y sectores reales, como industria, construcción, zonas francas, turismo y otros sectores.", engineering:"Ingeniería de datos", engineeringText:"La integración de datos se diseña alrededor de prácticas establecidas de ingeniería ETL, en la nube y de inteligencia artificial.", close:"Información disponible bajo demanda.", cta:"Coordinar una reunión"
} : {
  title:"DaaS Platform", lead:"Content on demand.", intro:"Centralize the data you need to improve productivity across your firm or institution.", documented:"Documented data", documentedText:"Cleaned and documented datasets organized through a structured data catalog.", ready:"Analysis-ready data", readyText:"Data stored, integrated and transformed for industry analysis on demand.", coverage:"Sector coverage", coverageText:"Macroeconomics, banking and real sectors, including industry, construction, free trade zones, tourism and other sectors.", engineering:"Data engineering", engineeringText:"Data integration is designed around established practices in ETL, cloud and AI engineering.", close:"Information provided on demand.", cta:"Schedule a meeting"
};
const sections = [
  [copy.documented, copy.documentedText],
  [copy.ready, copy.readyText],
  [copy.coverage, copy.coverageText],
  [copy.engineering, copy.engineeringText]
];
---
<BaseLayout title={`${copy.title} — ${siteConfig.name}`} description={copy.intro} path={path} language={language}>
  <header class="platform-intro surface-paper"><div class="shell platform-intro__inner"><p class="text-micro">CaribbeanQuant</p><h1>{copy.title}</h1><p class="platform-lead">{copy.lead}</p><p class="text-body-l">{copy.intro}</p></div></header>
  <div class="shell platform-sections">
    {sections.map(([title, text]) => <section><h2>{title}</h2><p>{text}</p></section>)}
  </div>
  <div class="shell platform-close"><p>{copy.close}</p><a href={`${prefix}/contact/`}>{copy.cta} →</a></div>
</BaseLayout>
<style>
  .platform-intro__inner{padding-block:var(--space-9);max-width:980px}.platform-intro h1{margin-top:var(--space-3)}.platform-lead{margin-top:var(--space-5);font:600 var(--size-h3)/var(--line-h3) var(--font-ui);color:var(--color-navy-900)}.platform-intro .text-body-l{margin-top:var(--space-3);max-width:65ch}.platform-sections section{display:grid;grid-template-columns:minmax(240px,4fr) minmax(0,8fr);gap:var(--space-8);padding-block:var(--space-7);border-bottom:var(--border-hairline)}.platform-close{display:flex;justify-content:space-between;align-items:center;gap:var(--space-5);padding-block:var(--space-7)}.platform-close p{font-weight:600;color:var(--color-navy-900)}.platform-close a{display:inline-flex;min-height:44px;align-items:center;font-weight:600}@media(max-width:768px){.platform-sections section{grid-template-columns:1fr;gap:var(--space-3)}.platform-intro__inner{padding-block:var(--space-8)}.platform-close{align-items:flex-start;flex-direction:column;gap:var(--space-2)}}
</style>
