---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig, type Language } from "../../config/site";
interface Props { language: Language }
const { language } = Astro.props;
const es = language === "es";
const prefix = es ? "/es" : "";
const path = `${prefix}/daas-platform/`;
const copy = es ? {
  title:"Plataforma DaaS", lead:"Contenido bajo demanda.", intro:"Datos documentados, dashboards y recursos analíticos diseñados para facilitar el descubrimiento, la comprensión y el uso de información económica, financiera y sectorial.", overview:"La plataforma reunirá fuentes, cobertura, frecuencia de actualización, metodología y condiciones de acceso en una estructura verificable.", resources:"Recursos disponibles", resourcesText:"El catálogo se publicará gradualmente cuando cada fuente y recurso tenga documentación suficiente.", products:"Solicitudes a la medida", productsText:"La estructura está preparada para solicitudes de contenido y productos analíticos definidos con claridad.", cta1:"Explorar recursos disponibles", cta2:"Coordinar una conversación", status:"En desarrollo"
} : {
  title:"DaaS Platform", lead:"Content on demand.", intro:"Documented datasets, dashboards and analytical resources designed to make economic, financial and sectoral data easier to discover, understand and use.", overview:"The platform will bring sources, coverage, update frequency, methodology and access conditions into a verifiable structure.", resources:"Available resources", resourcesText:"The catalog will be published gradually once each source and resource has sufficient documentation.", products:"Tailored requests", productsText:"The structure is ready for clearly scoped requests for content and analytical products.", cta1:"Explore available resources", cta2:"Schedule a conversation", status:"In development"
};
---
<BaseLayout title={`${copy.title} — ${siteConfig.name}`} description={copy.intro} path={path} language={language}>
  <header class="platform-intro surface-paper"><div class="shell platform-intro__inner"><p class="text-micro">CaribbeanQuant</p><h1>{copy.title}</h1><p class="platform-lead">{copy.lead}</p><p class="text-body-l">{copy.intro}</p></div></header>
  <div class="shell platform-sections">
    <section><div><span class="status">{copy.status}</span><h2>{es ? "Descripción general" : "Platform overview"}</h2></div><p>{copy.overview}</p></section>
    <section><div><span class="status">{copy.status}</span><h2>{copy.resources}</h2></div><p>{copy.resourcesText}</p></section>
    <section><div><span class="status">{copy.status}</span><h2>{copy.products}</h2></div><p>{copy.productsText}</p></section>
  </div>
  <div class="shell platform-actions"><a href={`${prefix}/resources/`}>{copy.cta1}</a><a href={`${prefix}/contact/`}>{copy.cta2}</a></div>
</BaseLayout>
<style>
  .platform-intro__inner{padding-block:var(--space-9);max-width:980px}.platform-intro h1{margin-top:var(--space-3)}.platform-lead{margin-top:var(--space-5);font:600 var(--size-h3)/var(--line-h3) var(--font-ui);color:var(--color-navy-900)}.platform-intro .text-body-l{margin-top:var(--space-3);max-width:65ch}.platform-sections section{display:grid;grid-template-columns:minmax(240px,4fr) minmax(0,8fr);gap:var(--space-8);padding-block:var(--space-7);border-bottom:var(--border-hairline)}.platform-sections h2{margin-top:var(--space-2)}.status{font:500 var(--size-micro)/1 var(--font-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--color-slate-500)}.platform-actions{display:flex;gap:var(--space-4);flex-wrap:wrap;padding-block:var(--space-7)}.platform-actions a{display:inline-flex;min-height:44px;align-items:center;padding-inline:var(--space-4);border:var(--border-strong);font-weight:600}.platform-actions a:first-child{background:var(--color-navy-900);color:var(--color-white)}@media(max-width:768px){.platform-sections section{grid-template-columns:1fr;gap:var(--space-3)}.platform-intro__inner{padding-block:var(--space-8)}}
</style>
