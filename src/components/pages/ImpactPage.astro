---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig, type Language } from "../../config/site";
interface Props { language: Language }
const { language } = Astro.props;
const es = language === "es";
const prefix = es ? "/es" : "";
const copy = es ? { title:"Productos de impacto", intro:"Productos cuantitativos que transforman datos en evidencia útil mediante preguntas claras, metodología documentada y limitaciones explícitas.", concept:"Producto cuantitativo especializado", status:"Vista conceptual · En desarrollo", text:"Un producto cuantitativo diseñado para traducir datos en medidas útiles para el análisis económico y financiero." } : { title:"Impact Products", intro:"Quantitative products that transform data into useful evidence through clear questions, documented methods and explicit limitations.", concept:"Specialized Quantitative Product", status:"Concept preview · In development", text:"A quantitative product designed to translate data into useful measures for economic and financial analysis." };
---
<BaseLayout title={`${copy.title} — ${siteConfig.name}`} description={copy.intro} path={`${prefix}/impact-products/`} language={language}>
  <header class="impact-intro surface-paper"><div class="shell"><p class="text-micro">CaribbeanQuant</p><h1>{copy.title}</h1><p class="text-body-l">{copy.intro}</p></div></header>
  <section class="shell concept"><div><p class="text-micro">{copy.status}</p><h2>{copy.concept}</h2></div><div><p class="text-body-l">{copy.text}</p></div></section>
</BaseLayout>
<style>
  .impact-intro .shell{padding-block:var(--space-9);max-width:980px}.impact-intro h1{margin-top:var(--space-3)}.impact-intro .text-body-l{margin-top:var(--space-5);max-width:64ch}.concept{display:grid;grid-template-columns:minmax(240px,4fr) minmax(0,8fr);gap:var(--space-8);padding-block:var(--space-8);border-bottom:var(--border-hairline)}.concept h2{margin-top:var(--space-3)}.concept .text-body-l::after{content:"";display:block;width:96px;margin-top:var(--space-4);border-top:2px solid var(--color-gold-500)}@media(max-width:768px){.concept{grid-template-columns:1fr;gap:var(--space-5)}.impact-intro .shell{padding-block:var(--space-8)}}
</style>
