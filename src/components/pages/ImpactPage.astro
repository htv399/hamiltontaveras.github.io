---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig, type Language } from "../../config/site";
interface Props { language: Language }
const { language } = Astro.props;
const es = language === "es";
const prefix = es ? "/es" : "";
const copy = es ? { title:"Productos de impacto", intro:"Productos cuantitativos que transforman datos en evidencia útil mediante preguntas claras, metodología documentada y limitaciones explícitas.", concept:"Índice de precios de vivienda", status:"Vista conceptual · En desarrollo", text:"Una futura pieza para estudiar la evolución de precios de vivienda con cobertura, fuentes, frecuencia y método debidamente documentados antes de publicar resultados.", note:"No se han publicado cifras ni resultados." } : { title:"Impact Products", intro:"Quantitative products that transform data into useful evidence through clear questions, documented methods and explicit limitations.", concept:"Housing Price Index", status:"Concept preview · In development", text:"A future product for studying housing price movements with coverage, sources, frequency and methodology documented before any results are released.", note:"No figures or results have been published." };
---
<BaseLayout title={`${copy.title} — ${siteConfig.name}`} description={copy.intro} path={`${prefix}/impact-products/`} language={language}>
  <header class="impact-intro surface-paper"><div class="shell"><p class="text-micro">CaribbeanQuant</p><h1>{copy.title}</h1><p class="text-body-l">{copy.intro}</p></div></header>
  <section class="shell concept"><div><p class="text-micro">{copy.status}</p><h2>{copy.concept}</h2></div><div><p class="text-body-l">{copy.text}</p><p class="concept-note">{copy.note}</p></div></section>
</BaseLayout>
<style>
  .impact-intro .shell{padding-block:var(--space-9);max-width:980px}.impact-intro h1{margin-top:var(--space-3)}.impact-intro .text-body-l{margin-top:var(--space-5);max-width:64ch}.concept{display:grid;grid-template-columns:minmax(240px,4fr) minmax(0,8fr);gap:var(--space-8);padding-block:var(--space-8);border-bottom:var(--border-hairline)}.concept h2{margin-top:var(--space-3)}.concept-note{margin-top:var(--space-4);padding-top:var(--space-3);border-top:var(--border-key-result);font-size:var(--size-small);color:var(--color-slate-500)}@media(max-width:768px){.concept{grid-template-columns:1fr;gap:var(--space-5)}.impact-intro .shell{padding-block:var(--space-8)}}
</style>
