---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig, canonicalBase, type Language } from "../../config/site";
interface Props { language: Language }
const { language } = Astro.props;
const es = language === "es";
const prefix = es ? "/es" : "";
const week = await getEntry("weeks", "introduccion-causalidad-tipos-datos");
if (!week) throw new Error("Published Econometrics I unit was not found.");
const { Content, headings } = await render(week);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const path = `${prefix}/teaching/econometrics-i/`;
const copy = es ? {
  back:"Docencia", label:"Curso", status:"Publicado · En desarrollo editorial", updated:"Última actualización", source:"Material fuente", resources:"Recursos disponibles", resourceValue:"Lectura académica · ecuaciones · tablas", toc:"En esta página", intro:"Esta primera unidad conserva el contenido académico original en español y adapta únicamente su presentación para la web.", language:"Español"
} : {
  back:"Teaching", label:"Course", status:"Published · Editorial development", updated:"Last updated", source:"Source material", resources:"Available resources", resourceValue:"Academic reading · equations · tables", toc:"On this page", intro:"Course materials available in Spanish. This first unit preserves the original academic content and adapts only its web presentation.", language:"Spanish"
};
const jsonLd={"@context":"https://schema.org","@type":"Course","name":"Econometrics I","description":week.data.summary,"inLanguage":"es","provider":{"@type":"Person","name":"Hamilton Taveras"},"url":`${canonicalBase.value.replace(/\/$/,"")}${path}`};
---
<BaseLayout title={`Econometrics I · ${es ? "Docencia" : "Teaching"} — ${siteConfig.name}`} description={week.data.summary} path={path} language={language} jsonLd={jsonLd}>
  <header class="course-header surface-paper"><div class="shell"><a class="course-back" href={`${prefix}/teaching/`}>← {copy.back}</a><p class="text-micro">{copy.label} · Econometrics I</p><h1>Econometrics I</h1><p class="course-intro">{copy.intro}</p><dl class="course-meta"><div><dt>{es ? "Idioma" : "Language"}</dt><dd>{copy.language}</dd></div><div><dt>{es ? "Estado" : "Status"}</dt><dd>{copy.status}</dd></div><div><dt>{copy.updated}</dt><dd>{es ? "18 de agosto de 2026" : "18 August 2026"}</dd></div><div><dt>{copy.source}</dt><dd><code>01-causalidad-tipos-datos/contenido.md</code></dd></div><div><dt>{copy.resources}</dt><dd>{copy.resourceValue}</dd></div></dl></div></header>
  <div class="shell academic-layout">
    <details class="toc-mobile"><summary>{copy.toc}</summary><nav aria-label={copy.toc}><ol>{toc.map((heading)=><li class:list={[heading.depth===3&&"toc-child"]}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></details>
    <article class="academic-content" lang="es" data-academic-content data-copy-label={es ? "Copiar enlace a" : "Copy link to"}><Content /></article>
    <aside class="toc-desktop"><nav aria-label={copy.toc}><p class="text-micro">{copy.toc}</p><ol>{toc.map((heading)=><li class:list={[heading.depth===3&&"toc-child"]}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></aside>
  </div>
  <script>
    const article = document.querySelector<HTMLElement>("[data-academic-content]");
    if (article) {
      const headings = [...article.querySelectorAll<HTMLElement>("h2[id],h3[id]")];
      for (const heading of headings) {
        const anchor = document.createElement("a");
        anchor.href = `#${heading.id}`;
        anchor.className = "heading-anchor";
        anchor.setAttribute("aria-label", `${article.dataset.copyLabel ?? "Copy link to"} ${heading.textContent ?? "section"}`);
        anchor.textContent = "#";
        anchor.addEventListener("click", () => navigator.clipboard?.writeText(location.origin + location.pathname + anchor.hash));
        heading.append(anchor);
      }
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-desktop a[href^="#"]')];
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (!visible) return;
        links.forEach((link) => link.toggleAttribute("aria-current", link.hash === `#${visible.target.id}`));
      }, { rootMargin: "-18% 0px -72% 0px" });
      headings.forEach((heading) => observer.observe(heading));
    }
  </script>
</BaseLayout>
<style is:global>
  .course-header .shell{padding-block:var(--space-8);max-width:1180px}.course-back{display:inline-flex;min-height:44px;align-items:center;font-weight:600;margin-bottom:var(--space-5)}.course-header h1{margin-top:var(--space-3)}.course-intro{margin-top:var(--space-4);font-size:var(--size-body-l);max-width:68ch}.course-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4);margin-top:var(--space-6);padding-block:var(--space-4);border-block:var(--border-hairline)}.course-meta div{min-width:0}.course-meta dt{font:500 var(--size-micro)/1.4 var(--font-ui);text-transform:uppercase;letter-spacing:.07em;color:var(--color-slate-500)}.course-meta dd{margin-top:var(--space-1);font-size:var(--size-small);overflow-wrap:anywhere}.course-meta code{font-family:var(--font-mono);font-size:.9em}.academic-layout{display:grid;grid-template-columns:minmax(0,760px) minmax(220px,300px);justify-content:center;gap:var(--space-9);padding-block:var(--space-8)}.academic-content{font-family:var(--font-editorial);font-size:1.075rem;line-height:1.68;min-width:0}.academic-content>*+*{margin-top:var(--space-4)}.academic-content h2{font-size:var(--size-h2);margin-top:var(--space-8);padding-top:var(--space-3);border-top:var(--border-strong)}.academic-content h3{font-size:var(--size-h3);margin-top:var(--space-7)}.academic-content h3{counter-increment:academic-section}.academic-content{counter-reset:academic-section}.academic-content h3::before{content:counter(academic-section) ". ";font-family:var(--font-mono);font-size:.75em;color:var(--color-blue-600)}.academic-content .heading-anchor{margin-left:var(--space-2);font:500 .75em/1 var(--font-mono);opacity:0;text-decoration:none}.academic-content h2:hover .heading-anchor,.academic-content h3:hover .heading-anchor,.academic-content .heading-anchor:focus{opacity:1}.academic-content table{display:block;width:max-content;min-width:100%;max-width:100%;overflow-x:auto;border-collapse:collapse;font-family:var(--font-ui);font-size:var(--size-small)}.academic-content th,.academic-content td{padding:var(--space-2) var(--space-3);border-bottom:var(--border-hairline);white-space:nowrap}.academic-content th{background:var(--color-mist-100);text-align:left}.academic-content pre{overflow-x:auto;padding:var(--space-4);background:var(--color-navy-900);color:var(--color-white);font-family:var(--font-mono);font-size:var(--size-small)}.academic-content .katex-display{overflow-x:auto;overflow-y:hidden;padding-block:var(--space-2)}.toc-desktop nav{position:sticky;top:calc(var(--header-height-desktop) + var(--space-5));max-height:calc(100vh - var(--header-height-desktop) - var(--space-8));overflow:auto;padding-left:var(--space-4);border-left:var(--border-hairline)}.toc-desktop ol,.toc-mobile ol{margin-top:var(--space-3);display:grid;gap:var(--space-2)}.toc-desktop a,.toc-mobile a{font-size:var(--size-small);line-height:1.35;color:var(--color-slate-500)}.toc-desktop a[aria-current]{color:var(--color-blue-600);font-weight:600}.toc-child{padding-left:var(--space-3)}.toc-mobile{display:none}.toc-mobile summary{cursor:pointer;font-weight:600;min-height:44px;padding-block:var(--space-3)}@media(max-width:900px){.course-meta{grid-template-columns:1fr 1fr}.academic-layout{grid-template-columns:1fr;gap:var(--space-5)}.toc-desktop{display:none}.toc-mobile{display:block;border-block:var(--border-hairline)}.academic-content{font-size:1rem}.academic-content h2{font-size:var(--size-h3)}.academic-content h3{font-size:1.18rem}}@media(max-width:480px){.course-meta{grid-template-columns:1fr}.academic-layout{padding-top:var(--space-5)}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}}
</style>
