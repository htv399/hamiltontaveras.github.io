---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isEligible } from "../../lib/contentGate";
import { siteConfig, canonicalBase, type Language } from "../../config/site";

interface Props { language: Language }
const { language } = Astro.props;
const es = language === "es";
const prefix = es ? "/es" : "";
const path = `${prefix}/teaching/econometrics-i/`;
const course = await getEntry("courses", "econometrics-i");
if (!course) throw new Error("Econometrics I course metadata was not found.");
const weeks = (await getCollection("weeks"))
  .filter((week) => week.data.course_id === course.data.id && isEligible(week.data, siteConfig.env))
  .sort((a, b) => a.data.week_number - b.data.week_number);
const firstWeek = weeks.find((week) => week.data.week_number === 1);
const legacyWeekAnchors = firstWeek ? (await render(firstWeek)).headings.map((heading) => heading.slug) : [];
const copy = es ? {
  back: "Docencia", label: "Curso", intro: "Material académico en español publicado como una secuencia de clases permanentes.", language: "Español", status: "Publicación académica continua", classes: "Clases", read: "Leer clase"
} : {
  back: "Teaching", label: "Course", intro: "Course materials available in Spanish and published as a sequence of permanent classes.", language: "Spanish", status: "Continuous academic publication", classes: "Classes", read: "Read class"
};
const jsonLd = { "@context": "https://schema.org", "@type": "Course", name: course.data.title, description: course.data.summary, inLanguage: "es", provider: { "@type": "Person", name: "Hamilton Taveras" }, url: `${canonicalBase.value.replace(/\/$/, "")}${path}` };
---
<BaseLayout title={`Econometrics I · ${es ? "Docencia" : "Teaching"} — ${siteConfig.name}`} description={course.data.summary} path={path} language={language} jsonLd={jsonLd}>
  <header class="course-header surface-paper">
    <div class="shell">
      <a class="course-back" href={`${prefix}/teaching/`}>← {copy.back}</a>
      <p class="text-micro">{copy.label} · {course.data.code}</p>
      <h1>Econometrics I</h1>
      <p class="course-description">{course.data.description}</p>
      <p class="course-intro">{copy.intro}</p>
      <dl class="course-meta">
        <div><dt>{es ? "Idioma" : "Language"}</dt><dd>{copy.language}</dd></div>
        <div><dt>{es ? "Estado" : "Status"}</dt><dd>{copy.status}</dd></div>
        <div><dt>{es ? "Clases publicadas" : "Published classes"}</dt><dd>{String(weeks.length).padStart(2, "0")}</dd></div>
      </dl>
    </div>
  </header>
  <section class="shell class-index" aria-labelledby="class-index-title" data-legacy-week-anchors={JSON.stringify(legacyWeekAnchors)}>
    <h2 id="class-index-title" class="text-micro">{copy.classes}</h2>
    <ol>
      {weeks.map((week) => {
        const number = String(week.data.week_number).padStart(2, "0");
        const href = `${prefix}/teaching/econometrics-i/week-${number}/`;
        return <li>
          <p class="class-number" aria-hidden="true">{number}</p>
          <div><h3>{week.data.title}</h3><p>{week.data.overview}</p></div>
          <a href={href} aria-label={`${copy.read}: ${week.data.title}`}>{copy.read} →</a>
        </li>;
      })}
    </ol>
  </section>
  <script>
    const classIndex = document.querySelector<HTMLElement>("[data-legacy-week-anchors]");
    if (classIndex && location.hash) {
      const legacyAnchors = JSON.parse(classIndex.dataset.legacyWeekAnchors ?? "[]") as string[];
      if (legacyAnchors.includes(decodeURIComponent(location.hash.slice(1)))) {
        location.replace(new URL(`week-01/${location.hash}`, location.href));
      }
    }
  </script>
</BaseLayout>
<style>
  .course-header .shell{padding-block:var(--space-8);max-width:1180px}.course-back{display:inline-flex;min-height:44px;align-items:center;font-weight:600;margin-bottom:var(--space-5)}.course-header h1{margin-top:var(--space-3)}.course-description{margin-top:var(--space-4);font:500 var(--size-body-l)/var(--line-body-l) var(--font-editorial);max-width:68ch}.course-intro{margin-top:var(--space-3);max-width:68ch}.course-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4);margin-top:var(--space-6);padding-block:var(--space-4);border-block:var(--border-hairline)}.course-meta dt{font:500 var(--size-micro)/1.4 var(--font-ui);text-transform:uppercase;letter-spacing:.07em;color:var(--color-slate-500)}.course-meta dd{margin-top:var(--space-1);font-size:var(--size-small)}.class-index{padding-block:var(--space-8)}.class-index>ol{margin-top:var(--space-4);border-top:var(--border-strong)}.class-index li{display:grid;grid-template-columns:80px minmax(0,1fr) max-content;gap:var(--space-5);align-items:start;padding-block:var(--space-6);border-bottom:var(--border-hairline)}.class-number{font:500 var(--size-body-l)/1 var(--font-mono);color:var(--color-blue-600)}.class-index h3{font:500 var(--size-h3)/var(--line-h3) var(--font-editorial)}.class-index h3+p{margin-top:var(--space-2);max-width:68ch;color:var(--color-slate-500)}.class-index a{display:inline-flex;align-items:center;min-height:44px;font-weight:600}@media(max-width:768px){.class-index li{grid-template-columns:48px 1fr}.class-index li>a{grid-column:2}.course-meta{grid-template-columns:1fr 1fr}}@media(max-width:480px){.course-meta{grid-template-columns:1fr}.class-index li{grid-template-columns:1fr}.class-index li>a{grid-column:1}.class-number{font-size:var(--size-small)}}
</style>
