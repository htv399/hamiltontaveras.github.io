---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig, canonicalBase, type Language } from "../../config/site";
interface Props { language: Language }
const { language } = Astro.props;
const es = language === "es";
const prefix = es ? "/es" : "";
const copy = es ? {
  label:"Sobre mí", description:"Economista, líder de datos y la persona detrás de CaribbeanQuant.",
  intro:["Antes de los datos y la economía estuvo el futsal. Continúo jugando activamente, soy seguidor del FC Barcelona desde siempre y admiro la comprensión del juego de Lionel Messi y Pep Guardiola.","Nací en Nueva Jersey, hijo de padres dominicanos, Bernardo Taveras y Josefina Vélez. Su trabajo, sacrificio y disciplina moldearon mi manera de asumir el aprendizaje, la responsabilidad y los proyectos de largo plazo.","Ese mismo interés por los sistemas define hoy mi trabajo. Estudio cómo se generan y gobiernan los datos, cómo se transforman en valor económico y cómo las decisiones de personas, empresas e instituciones inciden sobre los resultados sociales. Mi perspectiva económica tiene un fundamento esencialmente microeconómico."],
  experience:"Experiencia seleccionada", items:[["Vivienda y desarrollo","Como consultor del Banco Mundial, trabajé en las dimensiones económica, financiera, institucional y territorial del sector vivienda."],["Riesgo tributario y asignación de recursos","Dentro de la administración tributaria dominicana, lideré el diseño y la implementación de un proceso que prioriza el riesgo de los contribuyentes considerando la capacidad limitada de auditoría."],["Gobernanza de datos","Como Chief Data Governance Officer, he trabajado en el diseño y la implementación de un modelo de gobernanza de datos dentro de uno de los mayores entornos de datos del sector público de la República Dominicana."]],
  close:"CaribbeanQuant reúne estos intereses mediante plataformas de datos, razonamiento económico, productos cuantitativos, finanzas y docencia.", cv:"Ver CV", contact:"Contacto"
} : {
  label:"About Me", description:"Economist, data leader and the person behind CaribbeanQuant.",
  intro:["Before data and economics, there was futsal. I remain an active player, a lifelong FC Barcelona supporter and an admirer of Lionel Messi and Pep Guardiola’s understanding of the game.","I was born in New Jersey to Dominican parents, Bernardo Taveras and Josefina Vélez. Their work, sacrifice and discipline shaped how I approach learning, responsibility and long-term projects.","That same interest in systems defines my work today. I study how data is generated, governed and transformed into economic value, and how the decisions of individuals, firms and institutions shape social outcomes. My economic perspective is fundamentally microfounded."],
  experience:"Selected experience", items:[["Housing and development","As a World Bank consultant, I worked on the economic, financial, institutional and territorial dimensions of the housing sector."],["Tax risk and resource allocation","Within the Dominican tax administration, I led the design and implementation of a process that prioritizes taxpayer risk while accounting for limited audit capacity."],["Data governance","As Chief Data Governance Officer, I have worked on the design and implementation of a data governance model within one of the Dominican Republic’s largest public-sector data environments."]],
  close:"CaribbeanQuant brings these interests together through data platforms, economic reasoning, quantitative products, finance and teaching.", cv:"View CV", contact:"Contact"
};
const path=`${prefix}/about/`;
const jsonLd={"@context":"https://schema.org","@type":"Person",name:siteConfig.personName,description:copy.description,url:`${canonicalBase.value.replace(/\/$/,"")}${path}`};
---
<BaseLayout title={`${copy.label} — ${siteConfig.name}`} description={copy.description} path={path} language={language} jsonLd={jsonLd}>
  <section class="shell section-standard about-grid"><header><p class="text-micro">{copy.label}</p><h1>Hamilton Taveras</h1><p class="about-description">{copy.description}</p></header><div class="about-narrative">{copy.intro.map((paragraph)=><p>{paragraph}</p>)}<section><h2>{copy.experience}</h2><div class="experience-list">{copy.items.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div></section><p class="about-close">{copy.close}</p><div class="about-actions"><a href={`${prefix}/cv/`}>{copy.cv}</a><a href={`${prefix}/contact/`}>{copy.contact}</a></div></div></section>
</BaseLayout>
<style>
  .about-grid{display:grid;grid-template-columns:minmax(260px,4fr) minmax(0,8fr);gap:var(--space-9)}.about-grid header{position:sticky;top:calc(var(--header-height-desktop) + var(--space-5));align-self:start}.about-grid h1{margin-top:var(--space-3)}.about-description{margin-top:var(--space-4);font-size:var(--size-body-l);max-width:35ch}.about-narrative{max-width:68ch}.about-narrative>*+*{margin-top:var(--space-5)}.about-narrative section{margin-top:var(--space-8)}.experience-list{margin-top:var(--space-4)}.experience-list article{padding-block:var(--space-5);border-top:var(--border-hairline)}.experience-list article:last-child{border-bottom:var(--border-hairline)}.experience-list h3+p{margin-top:var(--space-2)}.about-close{font-weight:600;color:var(--color-navy-900)}.about-actions{display:flex;gap:var(--space-4);flex-wrap:wrap}.about-actions a{display:inline-flex;align-items:center;min-height:44px;padding-inline:var(--space-4);border:var(--border-strong);font-weight:600}.about-actions a:first-child{background:var(--color-navy-900);color:var(--color-white)}@media(max-width:768px){.about-grid{grid-template-columns:1fr;gap:var(--space-7)}.about-grid header{position:static}}
</style>
