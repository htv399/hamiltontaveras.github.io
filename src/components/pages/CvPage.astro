---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig, type Language } from "../../config/site";
import { cvData } from "../../data/cv";
interface Props { language: Language }
const { language } = Astro.props;
const es = language === "es";
const prefix = es ? "/es" : "";
const data = cvData[language];
const copy = es ? {label:"Currículum",download:"Descargar PDF",print:"Imprimir",back:"Volver a Sobre mí",index:"Índice del CV",source:"Vista HTML construida a partir del CV en inglés con fecha 2 de octubre de 2025."} : {label:"Curriculum vitae",download:"Download PDF",print:"Print",back:"Back to About Me",index:"CV index",source:"HTML view built from the English CV dated 2 October 2025."};
---
<BaseLayout title={`${copy.label} — ${siteConfig.name}`} description={data.profile} path={`${prefix}/cv/`} language={language}>
  <header class="cv-header surface-paper"><div class="shell"><p class="text-micro">{copy.label}</p><h1>Hamilton Taveras Vélez</h1><p class="cv-role">{data.role}</p><p class="cv-profile">{data.profile}</p><div class="cv-actions"><a href="/documents/hamilton-taveras-cv.pdf" download>{copy.download}</a><button type="button" data-print-cv>{copy.print}</button><a href={`${prefix}/about/`}>{copy.back}</a></div><p class="cv-source">{copy.source}</p></div></header>
  <div class="shell cv-layout">
    <aside class="cv-index-desktop"><nav aria-label={copy.index}><p class="text-micro">{copy.index}</p><ol>{data.sections.map((section)=><li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav></aside>
    <details class="cv-index-mobile"><summary>{copy.index}</summary><nav aria-label={copy.index}><ol>{data.sections.map((section)=><li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav></details>
    <article class="cv-content">{data.sections.map((section)=><section id={section.id}><h2>{section.title}</h2>{section.entries.map((entry)=><article class="cv-entry"><header><div><h3>{entry.title}</h3>{entry.organization&&<p>{entry.organization}</p>}</div>{entry.period&&<p class="cv-period">{entry.period}</p>}</header>{entry.details.length>0&&<ul>{entry.details.map((detail)=><li>{detail}</li>)}</ul>}</article>)}</section>)}</article>
  </div>
  <script>document.querySelector("[data-print-cv]")?.addEventListener("click",()=>window.print());</script>
</BaseLayout>
<style>
  .cv-header .shell{padding-block:var(--space-8)}.cv-header h1{margin-top:var(--space-3)}.cv-role{margin-top:var(--space-2);font:500 var(--size-body-l)/1.5 var(--font-ui);color:var(--color-blue-600)}.cv-profile{margin-top:var(--space-4);max-width:68ch}.cv-actions{display:flex;gap:var(--space-3);flex-wrap:wrap;margin-top:var(--space-5)}.cv-actions a,.cv-actions button{display:inline-flex;align-items:center;min-height:44px;padding-inline:var(--space-4);border:var(--border-strong);font-weight:600;color:var(--color-blue-600)}.cv-actions a:first-child{background:var(--color-navy-900);color:var(--color-white)}.cv-source{margin-top:var(--space-4);font-size:var(--size-small);color:var(--color-slate-500)}.cv-layout{display:grid;grid-template-columns:minmax(190px,2fr) minmax(0,9fr);gap:var(--space-8);padding-block:var(--space-8)}.cv-index-desktop nav{position:sticky;top:calc(var(--header-height-desktop) + var(--space-5));border-left:var(--border-hairline);padding-left:var(--space-4)}.cv-index-desktop ol,.cv-index-mobile ol{display:grid;gap:var(--space-2);margin-top:var(--space-3)}.cv-index-desktop a,.cv-index-mobile a{font-size:var(--size-small)}.cv-index-mobile{display:none}.cv-content{min-width:0}.cv-content>section{padding-block:var(--space-6);border-top:var(--border-strong);scroll-margin-top:calc(var(--header-height-desktop) + var(--space-4))}.cv-content>section:first-child{padding-top:0;border-top:0}.cv-content h2{margin-bottom:var(--space-4)}.cv-entry{padding-block:var(--space-4);border-top:var(--border-hairline)}.cv-entry>header{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--space-4)}.cv-entry h3{font-size:var(--size-body-l)}.cv-entry h3+p{margin-top:var(--space-1);color:var(--color-slate-500)}.cv-period{font:400 var(--size-small)/1.5 var(--font-mono);color:var(--color-slate-500);text-align:right}.cv-entry ul{margin-top:var(--space-3);padding-left:var(--space-5)}.cv-entry li+li{margin-top:var(--space-2)}@media(max-width:768px){.cv-layout{grid-template-columns:1fr;gap:var(--space-4)}.cv-index-desktop{display:none}.cv-index-mobile{display:block;border-block:var(--border-hairline)}.cv-index-mobile summary{min-height:44px;padding-block:var(--space-3);font-weight:600;cursor:pointer}.cv-entry>header{grid-template-columns:1fr}.cv-period{text-align:left}}
  @media print{.site-header,.site-footer,.skip-link,.cv-actions,.cv-index-desktop,.cv-index-mobile{display:none!important}.cv-header{background:white}.cv-header .shell,.cv-layout{padding:0}.cv-layout{display:block}.cv-content>section{break-inside:avoid-page}.cv-entry{break-inside:avoid}.cv-source{font-size:9pt}body{font-size:10pt;color:#000}a{color:#000!important;text-decoration:none!important}}
</style>
