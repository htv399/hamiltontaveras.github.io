---
export interface Indicator {
  label: string;
  value: string;
  unit: string;
  context: string;
  cutOffDate: string;
  source: string;
  status: "draft" | "review" | "published";
  demonstration: boolean;
}
interface Props { indicators: Indicator[] }
const publishable = Astro.props.indicators.filter((item) => item.status === "published");
---
{publishable.length > 0 && (
  <div class="indicator-strip" role="list" aria-label="Platform indicators, static data">
    {publishable.map((item) => (
      <article role="listitem" class="indicator">
        <div class="indicator__heading"><p class="u-tag">{item.label}</p>{item.demonstration && <span class="text-micro">Preview</span>}</div>
        <p class="indicator__value">{item.value}<span> {item.unit}</span></p>
        <p class="text-small">{item.context}</p>
        <p class="indicator__source text-micro">{item.cutOffDate} · {item.source}</p>
      </article>
    ))}
  </div>
)}

<style>
  .indicator-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); border-block: var(--border-strong); }
  .indicator { padding: var(--space-5); border-right: var(--border-hairline); }
  .indicator:last-child { border-right: 0; }
  .indicator__heading { display: flex; justify-content: space-between; gap: var(--space-2); }
  .indicator__value { margin-block: var(--space-3) var(--space-2); font: 500 var(--size-feature-title)/1 var(--font-mono); }
  .indicator__value span, .indicator__source { color: var(--color-slate-500); }
  .indicator__value span { font: 400 var(--size-micro)/1 var(--font-ui); }
  .indicator__source { margin-top: var(--space-3); }
  @media (max-width: 768px) { .indicator-strip { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; } .indicator { min-width: 240px; scroll-snap-align: start; } }
</style>
