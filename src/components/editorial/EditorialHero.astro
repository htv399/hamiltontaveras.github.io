---
interface HeroLink { label: string; href: string }
interface Props {
  brand: string;
  professionalName: string;
  professionalMeta: string;
  introduction: string;
  eyebrow: string;
  primaryCta: HeroLink;
  secondaryCta: HeroLink;
}
const { brand, professionalName, professionalMeta, introduction, eyebrow, primaryCta, secondaryCta } = Astro.props;
---
<section class="platform-hero surface-navy">
  <div class="shell platform-hero__inner">
    <p class="text-micro platform-hero__eyebrow">{eyebrow}</p>
    <h1>{brand}</h1>
    <div class="platform-hero__identity">
      <p class="platform-hero__descriptor">{professionalName}</p>
      <p class="platform-hero__professional-meta">{professionalMeta}</p>
    </div>
    <p class="platform-hero__intro">{introduction}</p>
    <div class="platform-hero__actions">
      <a class="platform-hero__primary" href={primaryCta.href}>{primaryCta.label}<span aria-hidden="true"> →</span></a>
      <a class="platform-hero__secondary" href={secondaryCta.href}>{secondaryCta.label}<span aria-hidden="true"> →</span></a>
    </div>
  </div>
</section>

<style>
  .platform-hero__inner { padding-block: calc(var(--header-height-desktop) + var(--space-8)) var(--space-9); max-width: 1080px; }
  .platform-hero__eyebrow { color: var(--color-mist-100); }
  .platform-hero h1 { margin-top: var(--space-4); color: var(--color-white); font: 600 var(--size-hero-name)/1.04 var(--font-ui); letter-spacing: -0.025em; }
  .platform-hero__identity { margin-top: var(--space-5); max-width: 62ch; }
  .platform-hero__descriptor { color: var(--color-white); font-size: clamp(1.05rem, 1.4vw, 1.25rem); line-height: 1.45; }
  .platform-hero__professional-meta { margin-top: var(--space-1); color: var(--color-mist-100); font-size: var(--size-small); font-style: italic; line-height: 1.55; }
  .platform-hero__intro { margin-top: var(--space-3); max-width: 66ch; color: var(--color-mist-100); font-size: var(--size-body); }
  .platform-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-6); }
  .platform-hero__actions a { display: inline-flex; align-items: center; min-height: 46px; padding: var(--space-3) var(--space-5); font-weight: 600; border: 1px solid var(--color-white); }
  .platform-hero__primary { background: var(--color-white); color: var(--color-navy-900) !important; }
  .platform-hero__secondary { color: var(--color-white); }
  .platform-hero__actions a:hover { background: var(--color-mist-100); color: var(--color-navy-900); }
  @media (max-width: 768px) { .platform-hero__inner { padding-block: calc(var(--header-height-mobile) + var(--space-7)) var(--space-8); } }
  @media (max-width: 480px) { .platform-hero__actions { align-items: stretch; flex-direction: column; } .platform-hero__actions a { justify-content: space-between; width: 100%; } }
</style>
