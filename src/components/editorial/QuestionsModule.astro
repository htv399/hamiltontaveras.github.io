---
// CMP-QUESTIONS. Authored questions only; no icon box per question.
interface Props {
  questions: string[]; // 2 to 5
}
const { questions } = Astro.props;
---
<ol class="questions-module">
  {questions.map((q, index) => (
    <li><span class="questions-module__number font-mono">0{index + 1}</span><p class="text-h3 font-editorial">{q}</p></li>
  ))}
</ol>

<style>
  .questions-module { display: grid; gap: var(--space-6); list-style: none; }
  .questions-module li { border-top: var(--border-strong); padding-top: var(--space-4); }
  .questions-module__number { display: block; color: var(--color-navy-900); font-size: var(--size-small); margin-bottom: var(--space-5); border-left: 2px solid var(--color-gold-500); padding-left: var(--space-2); }
  @media (min-width: 769px) { .questions-module { grid-template-columns: repeat(3, 1fr); } }
</style>
