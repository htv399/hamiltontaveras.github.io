---
// CMP-NOTES-ROW. Chronology stays visible; no cadence/frequency claim is
// made anywhere in this component's copy.
import type { RowItem } from "./EditorialRow.astro";

interface Props {
  items: RowItem[]; // 1 to 4
  language: "en" | "es";
}
const { items, language } = Astro.props;
---
<ul class="notes-row">
  {items.map((item) => (
    <li>
      <a href={item.href}>
        <div class="notes-row__meta">
          <span class="u-tag">{item.tags[0]?.replaceAll("-", " ")}</span>
          <p class="text-small">
          {item.publishedAt &&
            new Intl.DateTimeFormat(language, { year: "numeric", month: "short", day: "numeric" }).format(item.publishedAt)}
          </p>
        </div>
        <h4 class="text-h3 font-editorial">{item.title}</h4>
        <p class="text-small">{item.summary}</p>
      </a>
    </li>
  ))}
</ul>

<style>
  .notes-row { display: flex; flex-direction: column; }
  .notes-row li { border-top: var(--border-hairline); padding-block: var(--space-4); }
  .notes-row a { display: grid; grid-template-columns: 2fr 4fr 6fr; gap: var(--space-5); align-items: baseline; }
  .notes-row__meta { display: flex; flex-direction: column; gap: var(--space-1); }
  @media (max-width: 768px) { .notes-row a { grid-template-columns: 1fr; gap: var(--space-2); } }
</style>
