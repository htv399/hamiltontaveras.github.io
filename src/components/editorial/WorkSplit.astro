---
// CMP-WORK-SPLIT. Mixes evidence formats and avoids equal rectangles: the
// first item is wide, the rest sit in a narrower column.
import type { RowItem } from "./EditorialRow.astro";

interface Props {
  items: RowItem[]; // 2 to 4
  language: "en" | "es";
}
const { items } = Astro.props;
const [lead, ...rest] = items;
---
<div class="work-split">
  <article class="work-split__lead">
    <a href={lead.href}>
      <p class="u-tag">{lead.tags.slice(0, 3).join(" · ")}</p>
      <h3 class="text-h3">{lead.title}</h3>
      <p class="text-body">{lead.summary}</p>
    </a>
  </article>
  <div class="work-split__rest">
    {rest.map((item) => (
      <article>
        <a href={item.href}>
          <p class="u-tag">{item.tags.slice(0, 3).join(" · ")}</p>
          <h4 class="text-body-l">{item.title}</h4>
          <p class="text-small">{item.summary}</p>
        </a>
      </article>
    ))}
  </div>
</div>

<style>
  .work-split { display: grid; gap: var(--space-6); }
  @media (min-width: 769px) {
    .work-split { grid-template-columns: 8fr 4fr; }
  }
  .work-split__lead a > * + * { margin-top: var(--space-3); }
  .work-split__rest { display: flex; flex-direction: column; gap: var(--space-4); }
  .work-split__rest article { border-top: var(--border-hairline); padding-top: var(--space-3); }
  .work-split__rest a > * + * { margin-top: var(--space-1); }
</style>
