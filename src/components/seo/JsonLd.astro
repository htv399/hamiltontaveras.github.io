---
// REP-CMP-010 / TECH-SEO-001. Emits one JSON-LD script per provided object.
// Callers build the object (Person, Article, ScholarlyArticle, Dataset,
// Course, BreadcrumbList) so this component stays schema-agnostic.
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}
const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---
{items.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} is:inline />)}
