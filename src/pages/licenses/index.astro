---
// Footer utility page (IA-001 footer_navigation.required includes
// "licenses"). Not a numbered PG contract of its own; content follows
// PRD-026/CM-VAL-005 (a resource without a stated license is never treated
// as reusable) and reports the APP-006 policy status transparently.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";
import { licensePolicies, APP_006_RESOLVED } from "../../config/licenses";

const language = "en" as const;
---
<BaseLayout title={`Licenses — ${siteConfig.name}`} description="Licensing and reuse terms for this portal." path="/licenses/" language={language}>
  <section class="shell section-standard reading-column" style="margin-inline:auto;">
    <h1 class="text-h1 font-editorial">Licenses and reuse</h1>
    <p class="text-body-l">
      Unless a page states otherwise, all rights are reserved. Code, data, figures, teaching materials and third-party
      assets may carry separate licenses or access conditions.
    </p>
    <p class="text-body">
      Before reusing an item, check its page for source attribution, license, version and confidentiality notes. A
      missing license is not permission to reuse the material.
    </p>

    {!APP_006_RESOLVED && (
      <table class="data-table" style="margin-top: var(--space-6);">
        <caption>License policy status by content family (APP-006, approval_required)</caption>
        <thead><tr><th scope="col">Family</th><th scope="col">Status</th></tr></thead>
        <tbody>
          {licensePolicies.map((p) => (
            <tr><th scope="row">{p.family}</th><td>{p.resolved ? "Approved" : "Pending approval"}</td></tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</BaseLayout>
