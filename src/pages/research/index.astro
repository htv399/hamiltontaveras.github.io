---
// PG-RESEARCH. Research lead + recent perspectives + format filters +
// listing; empty_state omits lead/filters and explains scope in one
// paragraph, per 05-page-contracts.yml.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchFeature from "../../components/research/ResearchFeature.astro";
import { getCollection } from "astro:content";
import { isEligible } from "../../lib/contentGate";
import { siteConfig } from "../../config/site";

const language = "en" as const;
const all = (await getCollection("research")).filter((e) => isEligible(e.data, siteConfig.env));
const lead = all.find((r) => r.data.featured) ?? all[0];
---
<BaseLayout title={`Research — ${siteConfig.name}`} description="Applied research, working papers, replications and documented datasets." path="/research/" language={language}>
  <section class="shell section-standard">
    <header class="research-page__intro">
      <p class="text-micro">Research</p>
      <h1 class="text-display-l font-editorial">Questions, evidence and reproducible reasoning.</h1>
      <p class="text-body-l">Working papers and applied research presented as inspectable arguments: the question, contribution, principal reading, exhibit and resources remain in the same editorial frame.</p>
    </header>
    {all.length === 0 ? (
      <p class="text-body-l reading-column">
        No research item has been released in this version of the portal. A research item is published only when the
        question, evidence, method, limitations and citation information can be inspected independently.
      </p>
    ) : (
      <>
        {lead && (
          <ResearchFeature
            item={{
              title: lead.data.title,
              href: `/research/${lead.data.slug}/`,
              format: lead.data.format,
              authors: lead.data.authors,
              publishedAt: lead.data.published_at,
              keyFinding: lead.data.key_finding,
              abstract: lead.data.abstract,
              question: lead.data.question,
              contribution: lead.data.contribution,
              version: lead.data.version,
              status: lead.data.status,
              citation: lead.data.citation?.text,
              disclosure: "Preview disclosure: this fixture and its exhibit are synthetic demonstrations. They do not report completed research or real-world findings."
            }}
            language={language}
            expanded={true}
          />
        )}
      </>
    )}
  </section>
</BaseLayout>

<style>
  .research-page__intro { max-width: 860px; margin-bottom: var(--space-9); }
  .research-page__intro > * + * { margin-top: var(--space-4); }
  .research-page__intro .text-body-l { max-width: 66ch; }
</style>
