---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";
import { platformContent } from "../../config/platform";
import { isEligible } from "../../lib/contentGate";

const language = "en" as const;
const catalog = (await getCollection("catalogEntries")).filter((entry) => isEligible({ status: entry.data.status, access: entry.data.access_level }, siteConfig.env));
const dashboards = (await getCollection("dashboards")).filter((entry) => isEligible({ status: entry.data.status, access: entry.data.access_level }, siteConfig.env));
---
<BaseLayout title={`DaaS Platform — ${siteConfig.name}`} description={platformContent.daas.summary} path="/daas-platform/" language={language}>
  <header class="platform-intro surface-paper">
    <div class="shell platform-intro__inner">
      <p class="text-micro">CaribbeanQuant</p>
      <h1>DaaS Platform</h1>
      <p class="text-body-l">{platformContent.daas.summary}</p>
    </div>
  </header>

  <section class="shell section-standard module-row">
    <div><p class="text-micro">01</p><h2>Platform overview</h2></div>
    <p class="text-body-l">This area is structured to document data coverage, provenance, update practices, access levels and intended users as those details are approved for publication.</p>
  </section>

  {catalog.length > 0 && (
    <section class="shell section-standard module-row" aria-labelledby="catalog-heading">
      <div><p class="text-micro">02</p><h2 id="catalog-heading">Data catalog</h2></div>
      <div class="platform-list">{catalog.map((entry) => <article><p class="text-micro">{entry.data.access_level} · {entry.data.frequency}</p><h3>{entry.data.name}</h3><p>{entry.data.description}</p></article>)}</div>
    </section>
  )}

  {dashboards.length > 0 && (
    <section class="shell section-standard module-row" aria-labelledby="dashboards-heading">
      <div><p class="text-micro">03</p><h2 id="dashboards-heading">Dashboards and monitors</h2></div>
      <div class="platform-list">{dashboards.map((entry) => <article><p class="text-micro">{entry.data.kind} · {entry.data.access_level}</p><h3>{entry.data.title}</h3><p>{entry.data.summary}</p></article>)}</div>
    </section>
  )}

  {platformContent.businessExplorer.publishable && <section class="shell section-standard"><h2>{platformContent.businessExplorer.title}</h2></section>}
  {platformContent.meeting.href && <section class="shell section-dense"><a class="platform-cta" href={platformContent.meeting.href}>{platformContent.meeting.label}</a></section>}
</BaseLayout>

<style>
  .platform-intro__inner { padding-block: var(--space-9); max-width: 980px; }
  .platform-intro h1 { margin-top: var(--space-3); font-size: var(--size-h1); }
  .platform-intro .text-body-l { margin-top: var(--space-5); max-width: 64ch; }
  .module-row { display: grid; grid-template-columns: minmax(220px, 4fr) minmax(0, 8fr); gap: var(--space-8); border-bottom: var(--border-hairline); }
  .module-row h2 { margin-top: var(--space-2); }
  .platform-list article { padding-block: var(--space-5); border-top: var(--border-strong); }
  .platform-list article > * + * { margin-top: var(--space-2); }
  .platform-cta { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  @media (max-width: 768px) { .platform-intro__inner { padding-block: var(--space-8); } .module-row { grid-template-columns: 1fr; gap: var(--space-5); } }
</style>
