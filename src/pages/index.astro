---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialHero from "../components/editorial/EditorialHero.astro";
import IndicatorStrip from "../components/data/IndicatorStrip.astro";
import { siteConfig, canonicalBase } from "../config/site";
import { platformContent } from "../config/platform";
import { isEligible } from "../lib/contentGate";

const language = "en" as const;
const courses = (await getCollection("courses")).filter((entry) => isEligible(entry.data, siteConfig.env));
const catalogEntries = (await getCollection("catalogEntries")).filter((entry) => isEligible({ status: entry.data.status, access: entry.data.access_level }, siteConfig.env));
const products = (await getCollection("impactProducts")).filter((entry) => isEligible({ status: entry.data.status, access: entry.data.access_level }, siteConfig.env));
const featuredCourse = courses.find((entry) => entry.data.featured) ?? courses[0];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: siteConfig.name, description: siteConfig.descriptor, url: canonicalBase.value },
  { "@context": "https://schema.org", "@type": "Person", name: siteConfig.personName, description: siteConfig.descriptor, url: `${canonicalBase.value.replace(/\/$/, "")}/about/` }
];
---
<BaseLayout title={`${siteConfig.name} — Data platforms, quantitative products and teaching`} description={siteConfig.descriptor} path="/" language={language} headerVariant="transparent_on_navy_hero" jsonLd={jsonLd}>
  <EditorialHero brand={siteConfig.name} descriptor={siteConfig.descriptor} introduction={siteConfig.introduction} primaryCta={{ label: "Explore DaaS Platform", href: "/daas-platform/" }} secondaryCta={{ label: "About Me", href: "/about/" }} />

  {platformContent.indicators.length > 0 && (
    <section class="home-indicators surface-paper" aria-label="Platform indicators"><div class="shell"><IndicatorStrip indicators={[...platformContent.indicators]} /></div></section>
  )}

  <section class="home-preview section-standard surface-white">
    <div class="shell preview-grid">
      <div><p class="text-micro">Platform</p><h2>{platformContent.daas.title}</h2></div>
      <div><p class="text-body-l">{platformContent.daas.summary}</p>{catalogEntries.length > 0 && <p class="text-small">{catalogEntries.length} documented catalog {catalogEntries.length === 1 ? "entry" : "entries"}.</p>}<a class="section-link" href="/daas-platform/">Explore the platform <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="home-preview section-standard surface-paper">
    <div class="shell preview-grid">
      <div><p class="text-micro">Products</p><h2>{platformContent.impact.title}</h2></div>
      <div><p class="text-body-l">{platformContent.impact.summary}</p>{products.slice(0, 2).map((product) => <article class="compact-item"><p class="text-micro">{product.data.language.toUpperCase()} · {product.data.status}</p><h3 class="font-editorial">{product.data.title}</h3><p>{product.data.summary}</p></article>)}<a class="section-link" href="/impact-products/">Explore impact products <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="home-preview section-standard surface-white">
    <div class="shell preview-grid">
      <div><p class="text-micro">Academic publication</p><h2>{platformContent.teaching.title}</h2></div>
      <div><p class="text-body-l">{platformContent.teaching.summary}</p>{featuredCourse && <article class="compact-item"><p class="text-micro">{featuredCourse.data.language.toUpperCase()} · {featuredCourse.data.period}</p><h3 class="font-editorial"><a href={`/teaching/${featuredCourse.data.slug}/`}>{featuredCourse.data.title}</a></h3><p>{featuredCourse.data.summary}</p></article>}<a class="section-link" href="/teaching/">Explore teaching <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="home-preview section-standard surface-mist">
    <div class="shell preview-grid">
      <div><p class="text-micro">About</p><h2>Hamilton Taveras</h2></div>
      <div><p class="text-body-l">Hamilton Taveras is the person behind CaribbeanQuant.</p><p>{siteConfig.descriptor}</p><div class="home-actions"><a class="section-link" href="/about/">About Me →</a><a class="section-link" href="/cv/">CV →</a></div></div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-indicators { padding-block: var(--space-6); }
  .preview-grid { display: grid; grid-template-columns: minmax(220px, 4fr) minmax(0, 8fr); gap: var(--space-8); }
  .preview-grid h2 { margin-top: var(--space-2); font-size: var(--size-section-title); }
  .preview-grid > div:last-child > * + * { margin-top: var(--space-4); }
  .section-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .compact-item { border-top: var(--border-strong); padding-top: var(--space-4); }
  .compact-item > * + * { margin-top: var(--space-2); }
  .compact-item h3 { font-size: var(--size-h3); }
  .home-actions { display: flex; gap: var(--space-5); flex-wrap: wrap; }
  @media (max-width: 768px) { .preview-grid { grid-template-columns: 1fr; gap: var(--space-5); } }
</style>
