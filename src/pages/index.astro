---
// PG-HOME. Spanish is the primary preview language. Optional publication
// modules remain available on their own routes and are intentionally omitted
// here so the landing page works as a concise professional portfolio.
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialHero from "../components/editorial/EditorialHero.astro";
import FeaturedAnalysisGrid from "../components/editorial/FeaturedAnalysisGrid.astro";
import BackgroundContact from "../components/editorial/BackgroundContact.astro";
import IndicatorStrip from "../components/data/IndicatorStrip.astro";
import { buildHomeViewModel } from "../lib/homeData";
import { siteConfig, descriptorEs } from "../config/site";

const language = "es" as const;
const vm = await buildHomeViewModel(language, siteConfig.env);
const thesis = "Información, modelos, juicio y valor: un método para convertir datos en evidencia económica y financiera clara.";
const indicators = [
  { label: "Actividad sintética", value: "104.8", unit: "índice", change: { direction: "up" as const, label: "+1.6 pts sintéticos" }, data_vintage: "23 ago 2026", source: "Serie sintética de preview" },
  { label: "Dispersión del modelo", value: "7.2", unit: "rango", change: { direction: "down" as const, label: "−0.8 pts sintéticos" }, data_vintage: "23 ago 2026", source: "Serie sintética de preview" },
  { label: "Cobertura de datos", value: "88", unit: "% sintético", change: { direction: "up" as const, label: "+4 pts sintéticos" }, data_vintage: "23 ago 2026", source: "Serie sintética de preview" },
  { label: "Balance de escenarios", value: "52", unit: "índice", change: { direction: "flat" as const, label: "0.0 pts sintéticos" }, data_vintage: "23 ago 2026", source: "Serie sintética de preview" }
];
const order = ["project", "data-product", "valuation"];
const selectedWork = [...vm.workRows].sort((a, b) => order.indexOf(a.tags[0]) - order.indexOf(b.tags[0])).slice(0, 3);
---
<BaseLayout title={`${siteConfig.name} — ${descriptorEs}`} description={descriptorEs} path="/" language={language} headerVariant="transparent_on_navy_hero">
  {vm.hasLead && vm.lead && (
    <EditorialHero name={siteConfig.name} descriptor={descriptorEs} thesis={thesis} lead={{ title: vm.lead.data.title, slug: vm.lead.data.slug, key_finding: vm.lead.data.key_finding, published_at: vm.lead.data.published_at, domains: vm.lead.data.domains, evidence: vm.lead.data.evidence }} language={language} />
  )}
  <section class="home-indicators surface-paper">
    <div class="shell">
      <div class="home-indicators__intro"><p class="text-micro">Indicadores de preview</p><p class="text-small">Señales sintéticas para mostrar el sistema; no representan datos reales.</p></div>
      <IndicatorStrip indicators={indicators} language={language} />
    </div>
  </section>
  {selectedWork.length === 3 && (
    <section class="home-work section-standard surface-white">
      <div class="shell">
        <header class="home-section-head"><p class="text-micro">Trabajo seleccionado · contenido demostrativo</p><h2>Evidencia para decisiones económicas y financieras</h2><p>Una muestra visual de cómo se documentan preguntas, arquitectura de datos y supuestos de valoración.</p></header>
        <FeaturedAnalysisGrid primary={selectedWork[0]} secondary={[selectedWork[1], selectedWork[2]]} language={language} />
      </div>
    </section>
  )}
  <BackgroundContact bioShort="Economista enfocado en sistemas de datos, análisis cuantitativo y valoración, con énfasis en evidencia clara y decisiones trazables." aboutHref="/es/about/" cvHref="/es/cv/" contactHref="/es/contact/" contact={{ mode: siteConfig.contactMode }} language={language} />
</BaseLayout>
<style>
  .home-indicators { padding-block: var(--space-5); }
  .home-indicators__intro { display: flex; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-4); }
  .home-section-head { margin-bottom: var(--space-7); max-width: 800px; }
  .home-section-head > * + * { margin-top: var(--space-2); }
  .home-section-head h2 { font-size: var(--size-section-title); line-height: 1.15; }
  .home-section-head > p:last-child { font-size: var(--size-body); }
  @media (max-width: 768px) { .home-indicators__intro { flex-direction: column; gap: var(--space-1); } .home-section-head { margin-bottom: var(--space-5); } }
</style>
