---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Search from "../../../components/search/Search.tsx";
import { siteConfig } from "../../../config/site";
import { t } from "../../../i18n/ui";
const language = "es" as const;
const strings = t(language);
---
<BaseLayout title={`Buscar — ${siteConfig.name}`} description="Busca títulos, resúmenes y contenido publicado en CaribbeanQuant." path="/es/search/" language={language}>
  <section class="shell section-standard"><h1>{strings.search}</h1><div style="margin-top:var(--space-6)"><Search client:idle language={language} placeholder={strings.searchPlaceholder} idleLabel={strings.searchIdle} loadingLabel={strings.searchLoading} emptyLabel={strings.searchEmpty} errorLabel={strings.searchError} resultLabelOne={strings.searchResultLabelOne} resultLabelMany={strings.searchResultLabelMany}/></div><noscript><p>La búsqueda requiere JavaScript. Explora la <a href="/es/daas-platform/">Plataforma DaaS</a>, los <a href="/es/impact-products/">Productos de impacto</a> o <a href="/es/teaching/">Docencia</a>.</p></noscript></section>
</BaseLayout>
