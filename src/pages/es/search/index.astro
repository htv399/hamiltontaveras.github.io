---
// PG-SEARCH (Spanish equivalent).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Search from "../../../components/search/Search.tsx";
import { siteConfig } from "../../../config/site";
import { t } from "../../../i18n/ui";

const language = "es" as const;
const strings = t(language);
---
<BaseLayout title={`Buscar — ${siteConfig.name}`} description="Busca títulos, resúmenes, dominios, métodos y contenido." path="/es/search/" language={language}>
  <section class="shell section-standard">
    <h1 class="text-h1 font-editorial">{strings.search}</h1>
    <div style="margin-top: var(--space-6);">
      <Search
        client:idle
        language={language}
        placeholder={strings.searchPlaceholder}
        idleLabel={strings.searchIdle}
        loadingLabel={strings.searchLoading}
        emptyLabel={strings.searchEmpty}
        errorLabel={strings.searchError}
        resultLabelOne={strings.searchResultLabelOne}
        resultLabelMany={strings.searchResultLabelMany}
      />
    </div>
    <noscript>
      <p class="text-small">La búsqueda requiere JavaScript. Explora <a href="/es/work/">Trabajo</a>,
        <a href="/es/research/">Investigación</a> o <a href="/es/notes/">Notas</a>.</p>
    </noscript>
  </section>
</BaseLayout>
