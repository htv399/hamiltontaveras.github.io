---
// PG-RESEARCH (Spanish equivalent).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ResearchFeature from "../../../components/research/ResearchFeature.astro";
import { getCollection } from "astro:content";
import { isEligible } from "../../../lib/contentGate";
import { siteConfig } from "../../../config/site";

const language = "es" as const;
const all = (await getCollection("research")).filter((e) => isEligible(e.data, siteConfig.env));
const lead = all.find((r) => r.data.featured) ?? all[0];
---
<BaseLayout title={`Investigación — ${siteConfig.name}`} description="Investigación aplicada, working papers, réplicas y conjuntos de datos documentados." path="/es/research/" language={language}>
  <section class="shell section-standard">
    <header class="research-page__intro">
      <p class="text-micro">Investigación</p>
      <h1 class="text-display-l font-editorial">Preguntas, evidencia y razonamiento reproducible.</h1>
      <p class="text-body-l">Working papers e investigación aplicada presentados como argumentos inspeccionables: pregunta, contribución, lectura principal, evidencia y recursos conviven en un mismo marco editorial.</p>
    </header>
    {all.length === 0 ? (
      <p class="text-body-l reading-column">
        Ningún elemento de investigación se ha publicado en esta versión del portal. Un elemento se publica solo cuando
        la pregunta, la evidencia, el método, las limitaciones y la cita pueden revisarse de forma independiente.
      </p>
    ) : (
      <>
        {lead && (
          <ResearchFeature
            item={{
              title: lead.data.title,
              href: `/research/${lead.data.slug}/`,
              format: lead.data.format,
              authors: lead.data.authors,
              publishedAt: lead.data.published_at,
              keyFinding: lead.data.key_finding,
              abstract: lead.data.abstract,
              question: lead.data.question,
              contribution: lead.data.contribution,
              version: lead.data.version,
              status: lead.data.status,
              citation: lead.data.citation?.text,
              disclosure: "Aviso de preview: este fixture y su evidencia son demostraciones sintéticas. No comunican una investigación terminada ni hallazgos reales."
            }}
            language={language}
            expanded={true}
          />
        )}
      </>
    )}
  </section>
</BaseLayout>

<style>
  .research-page__intro { max-width: 860px; margin-bottom: var(--space-9); }
  .research-page__intro > * + * { margin-top: var(--space-4); }
  .research-page__intro .text-body-l { max-width: 66ch; }
</style>
