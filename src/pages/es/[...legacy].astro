---
import LegacyRedirect from "../../components/navigation/LegacyRedirect.astro";
export function getStaticPaths() {
  const mappings = {
    work: "/daas-platform/",
    research: "/impact-products/",
    notes: "/impact-products/",
    teaching: "/teaching/",
    about: "/about/",
    cv: "/cv/",
    contact: "/contact/",
    resources: "/resources/",
    search: "/search/",
    licenses: "/licenses/",
    accessibility: "/accessibility/"
  } as const;
  return Object.entries(mappings).map(([legacy, to]) => ({ params: { legacy }, props: { from: `/es/${legacy}/`, to } }));
}
const { from, to } = Astro.props;
---
<LegacyRedirect from={from} to={to} />
