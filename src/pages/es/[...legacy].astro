---
import LegacyRedirect from "../../components/navigation/LegacyRedirect.astro";
export function getStaticPaths() {
  const mappings = {
    work: "/es/daas-platform/",
    research: "/es/impact-products/",
    notes: "/es/impact-products/"
  } as const;
  return Object.entries(mappings).map(([legacy, to]) => ({ params: { legacy }, props: { from: `/es/${legacy}/`, to } }));
}
const { from, to } = Astro.props;
---
<LegacyRedirect from={from} to={to} language="es" />
