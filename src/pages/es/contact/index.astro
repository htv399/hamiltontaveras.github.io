---
// PG-CONTACT (Spanish equivalent).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { siteConfig, contactMode } from "../../../config/site";
import { assertNotBlockedInProduction } from "../../../lib/productionGate";
import { t } from "../../../i18n/ui";

assertNotBlockedInProduction(contactMode.resolved, "Contact (es)", "APP-005");

const language = "es" as const;
const strings = t(language);
---
<BaseLayout title={`Contacto — ${siteConfig.name}`} description="Contacto para consultas de investigación, docencia y trabajo profesional." path="/es/contact/" language={language}>
  <section class="shell section-standard reading-column" style="margin-inline:auto;">
    <h1 class="text-h1 font-editorial">Contacto</h1>
    <p class="text-body-l">
      Para consultas de investigación, docencia o trabajo profesional, usa un canal público verificado una vez
      aprobado.
    </p>
    <p class="text-body" data-placeholder="true">{strings.contactPending}</p>
    <p class="text-small">
      Esta página no incluye deliberadamente una dirección de relleno ni un perfil social sin verificar.
    </p>
  </section>
</BaseLayout>
