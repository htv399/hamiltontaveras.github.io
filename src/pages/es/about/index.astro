---
// PG-ABOUT (Spanish equivalent). See src/pages/about/index.astro for the
// APP-008 production gate rationale.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { siteConfig, descriptorEs, realInventoryApproved } from "../../../config/site";
import { assertNotBlockedInProduction } from "../../../lib/productionGate";

assertNotBlockedInProduction(realInventoryApproved, "About (es)", "APP-008");

const language = "es" as const;
---
<BaseLayout title={`Perfil — ${siteConfig.name}`} description={descriptorEs} path="/es/about/" language={language}>
  <section class="shell section-standard reading-column" style="margin-inline:auto;">
    <p class="u-tag" data-placeholder="true">Contenido pendiente — APP-008</p>
    <h1 class="text-h1 font-editorial">{siteConfig.name}</h1>
    <p class="text-body-l">{descriptorEs}</p>

    <h2 class="text-h3" style="margin-top: var(--space-8);">Información, Modelos, Juicio, Valor</h2>
    <p class="text-body">{siteConfig.thesis}</p>

    <p class="text-body" style="margin-top: var(--space-6);">
      Una biografía verificada, una trayectoria seleccionada y el contexto docente y de investigación aparecerán aquí
      una vez aprobados (decisión APP-008). Esta página no publica experiencia, credenciales ni afiliación
      institucional inventadas mientras tanto.
    </p>

    <div class="cluster" style="margin-top: var(--space-8);">
      <a href="/es/cv/">Ver CV</a>
      <a href="/es/contact/">Contacto</a>
    </div>
  </section>
</BaseLayout>
