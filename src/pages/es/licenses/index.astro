---
// Footer utility page (Spanish equivalent).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { siteConfig } from "../../../config/site";
import { licensePolicies, APP_006_RESOLVED } from "../../../config/licenses";

const language = "es" as const;
---
<BaseLayout title={`Licencias — ${siteConfig.name}`} description="Términos de licencia y reutilización de este portal." path="/es/licenses/" language={language}>
  <section class="shell section-standard reading-column" style="margin-inline:auto;">
    <h1 class="text-h1 font-editorial">Licencias y reutilización</h1>
    <p class="text-body-l">
      Salvo que una página indique lo contrario, todos los derechos están reservados. Código, datos, figuras,
      materiales docentes y recursos de terceros pueden tener licencias o condiciones de acceso independientes.
    </p>
    <p class="text-body">
      Antes de reutilizar un elemento, revisa su página para conocer la atribución de fuente, la licencia, la versión
      y las notas de confidencialidad. Una licencia ausente no es permiso para reutilizar el material.
    </p>

    {!APP_006_RESOLVED && (
      <table class="data-table" style="margin-top: var(--space-6);">
        <caption>Estado de la política de licencias por familia de contenido (APP-006, sujeto a aprobación)</caption>
        <thead><tr><th scope="col">Familia</th><th scope="col">Estado</th></tr></thead>
        <tbody>
          {licensePolicies.map((p) => (
            <tr><th scope="row">{p.family}</th><td>{p.resolved ? "Aprobada" : "Pendiente de aprobación"}</td></tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</BaseLayout>
