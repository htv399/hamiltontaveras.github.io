---
// PG-HOME (Spanish). PG-ES-001: reuses the same component contracts and
// localized UI strings; no duplicated editorial pieces are required.
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialHero from "../../components/editorial/EditorialHero.astro";
import EditorialRow from "../../components/editorial/EditorialRow.astro";
import FeaturedAnalysisGrid from "../../components/editorial/FeaturedAnalysisGrid.astro";
import QuestionsModule from "../../components/editorial/QuestionsModule.astro";
import WorkSplit from "../../components/editorial/WorkSplit.astro";
import ResearchFeature from "../../components/research/ResearchFeature.astro";
import NotesRow from "../../components/editorial/NotesRow.astro";
import CourseShelf from "../../components/teaching/CourseShelf.astro";
import BackgroundContact from "../../components/editorial/BackgroundContact.astro";
import IndicatorStrip from "../../components/data/IndicatorStrip.astro";
import { buildHomeViewModel } from "../../lib/homeData";
import { siteConfig, descriptorEs } from "../../config/site";

const language = "es" as const;
const siteEnv = siteConfig.env;
const vm = await buildHomeViewModel(language, siteEnv);

const editorialQuestions = [
  "¿Cómo puede la información institucional volverse lo bastante confiable para sostener una decisión económica?",
  "¿Qué supuestos determinan realmente el resultado de una valoración, y qué tan sensible es ese resultado?",
  "¿Cómo debe comunicarse la evidencia cuantitativa cuando la incertidumbre forma parte de la respuesta?"
];
const indicators = [
  { label: "Actividad sintética", value: "104.8", unit: "índice", change: { direction: "up" as const, label: "+1.6 pts demo" }, data_vintage: "23 ago 2026", source: "Serie sintética de preview" },
  { label: "Dispersión del modelo", value: "7.2", unit: "rango", change: { direction: "down" as const, label: "−0.8 pts demo" }, data_vintage: "23 ago 2026", source: "Serie sintética de preview" },
  { label: "Cobertura de datos", value: "88", unit: "% demo", change: { direction: "up" as const, label: "+4 pts demo" }, data_vintage: "23 ago 2026", source: "Serie sintética de preview" },
  { label: "Balance de escenarios", value: "52", unit: "índice", change: { direction: "flat" as const, label: "0.0 pts demo" }, data_vintage: "23 ago 2026", source: "Serie sintética de preview" }
];
const featuredItems = vm.lead ? [{ title: vm.lead.data.title, href: vm.analysisHref(vm.lead.data.slug), summary: vm.lead.data.key_finding, publishedAt: vm.lead.data.published_at, tags: ["analysis", ...vm.lead.data.domains] }, ...vm.workRows.slice(0, 2)] : vm.workRows;
---
<BaseLayout
  title={`${siteConfig.name} — ${descriptorEs}`}
  description={descriptorEs}
  path="/es/"
  language={language}
  headerVariant="transparent_on_navy_hero"
>
  {vm.hasLead && vm.lead && (
    <EditorialHero
      name={siteConfig.name}
      descriptor={descriptorEs}
      thesis="Información, modelos, juicio y valor: un método de trabajo que convierte datos en evidencia económica y financiera clara."
      lead={{
        title: vm.lead.data.title,
        slug: vm.lead.data.slug,
        key_finding: vm.lead.data.key_finding,
        published_at: vm.lead.data.published_at,
        domains: vm.lead.data.domains,
        evidence: vm.lead.data.evidence
      }}
      language={language}
    />
  )}

  <section class="home-indicators surface-paper"><div class="shell"><div class="home-indicators__intro"><p class="text-micro">Datos demostrativos</p><p class="text-small">Señales sintéticas usadas solo para previsualizar el sistema editorial.</p></div><IndicatorStrip indicators={indicators} language={language} /></div></section>

  {featuredItems.length >= 3 && (
    <section class="section-standard surface-white">
      <div class="shell">
        <header class="home-section-head"><p class="text-micro">Inteligencia seleccionada</p><h2 class="text-h2 font-editorial">Evidencia organizada por decisión</h2></header>
        <FeaturedAnalysisGrid primary={featuredItems[0]} secondary={[featuredItems[1], featuredItems[2]]} language={language} />
      </div>
    </section>
  )}
  {featuredItems.length > 0 && featuredItems.length < 3 && (
    <section class="section-dense surface-white">
      <div class="shell">
        {featuredItems.map((item) => <EditorialRow item={item} emphasis="standard" language={language} />)}
      </div>
    </section>
  )}

  <section class="section-dense surface-paper">
    <div class="shell">
      <header class="home-section-head"><p class="text-micro">Preguntas que organizan el trabajo</p><h2 class="text-h2 font-editorial">Donde la evidencia encuentra el juicio</h2></header>
      <QuestionsModule questions={editorialQuestions} />
    </div>
  </section>

  {vm.hasWorkSplit && (
    <section class="section-standard surface-white">
      <div class="shell">
        <header class="home-section-head"><p class="text-micro">Trabajo</p><h2 class="text-h2 font-editorial">Sistemas, productos y evidencia de valoración</h2><p class="text-body">Tres formatos sintéticos muestran cómo hacer inspeccionables las preguntas, la arquitectura y el juicio cuantitativo.</p></header>
        <div style="margin-top: var(--space-6);">
          <WorkSplit items={vm.workRows.slice(0, 4)} language={language} />
        </div>
      </div>
    </section>
  )}

  {vm.hasResearch && vm.research[0] && (
    <section class="section-standard surface-mist">
      <div class="shell">
        <ResearchFeature
          item={{
            title: vm.research[0].data.title,
            href: vm.researchHref(vm.research[0].data.slug),
            format: vm.research[0].data.format,
            authors: vm.research[0].data.authors,
            publishedAt: vm.research[0].data.published_at,
            keyFinding: vm.research[0].data.key_finding
          }}
          language={language}
        />
      </div>
    </section>
  )}

  {vm.hasNotes && (
    <section class="section-dense surface-white">
      <div class="shell">
        <header class="home-section-head"><p class="text-micro">Notas</p><h2 class="text-h2 font-editorial">Observaciones analíticas breves</h2></header>
        <div style="margin-top: var(--space-5);">
          <NotesRow items={vm.notesRows} language={language} />
        </div>
      </div>
    </section>
  )}

  {vm.hasCourses && (
    <section class="section-dense surface-paper">
      <div class="shell">
        <header class="home-section-head"><p class="text-micro">Docencia</p><h2 class="text-h2 font-editorial">Métodos presentados como publicación académica</h2></header>
        <div style="margin-top: var(--space-5);">
          <CourseShelf
            courses={vm.courses.map((c) => ({
              title: c.data.title,
              href: vm.courseHref(c.data.slug),
              period: c.data.period,
              archived: c.data.archived ?? false,
              summary: c.data.summary
            }))}
            language={language}
          />
        </div>
      </div>
    </section>
  )}

  <BackgroundContact
    bioShort={descriptorEs}
    cvHref="/es/cv/"
    contact={{ mode: siteConfig.contactMode }}
    language={language}
  />
</BaseLayout>

<style>
  .home-indicators { padding-block: var(--space-5); }
  .home-indicators__intro { display: flex; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-4); }
  .home-section-head { margin-bottom: var(--space-7); max-width: 880px; }
  .home-section-head > * + * { margin-top: var(--space-2); }
  @media (max-width: 768px) { .home-indicators__intro { flex-direction: column; gap: var(--space-1); } .home-section-head { margin-bottom: var(--space-5); } }
</style>
