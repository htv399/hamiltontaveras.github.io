---
// PG-CV (Spanish equivalent).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { siteConfig, realInventoryApproved } from "../../../config/site";
import { assertNotBlockedInProduction } from "../../../lib/productionGate";

assertNotBlockedInProduction(realInventoryApproved, "CV (es)", "APP-008");

const language = "es" as const;
---
<BaseLayout title={`Currículum vitae — ${siteConfig.name}`} description="Currículum vitae verificado." path="/es/cv/" language={language}>
  <section class="shell section-standard reading-column" style="margin-inline:auto;">
    <p class="u-tag" data-placeholder="true">Contenido pendiente — APP-008</p>
    <h1 class="text-h1 font-editorial">Currículum vitae</h1>
    <p class="text-body-l">
      Esta página está reservada para el CV público verificado. Una cronología estructurada y un PDF descargable
      aparecerán aquí solo después de que fechas, cargos, afiliaciones y datos de contacto completen la revisión
      editorial.
    </p>
    <p class="text-body">
      Para un resumen breve, visita <a href="/es/about/">Perfil</a>. Para consultas profesionales, visita
      <a href="/es/contact/">Contacto</a>.
    </p>
  </section>
</BaseLayout>
