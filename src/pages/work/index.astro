---
// PG-WORK. Editorial intro, optional featured work, filters and a mixed
// editorial listing; empty_state explains scope instead of showing empty
// filters (05-page-contracts.yml).
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkSplit from "../../components/editorial/WorkSplit.astro";
import { getCollection } from "astro:content";
import { isEligible } from "../../lib/contentGate";
import { siteConfig } from "../../config/site";

const language = "en" as const;
const allWork = (await getCollection("work")).filter((e) => isEligible(e.data, siteConfig.env));
const rows = allWork.map((w) => ({
  id: w.data.id,
  title: w.data.title,
  href: `/work/${w.data.slug}/`,
  summary: w.data.summary,
  publishedAt: w.data.published_at,
  tags: [w.data.kind, ...w.data.domains]
}));
---
<BaseLayout title={`Work — ${siteConfig.name}`} description="Selected work in data systems, economics, corporate finance, valuation and quantitative finance." path="/work/" language={language}>
  <section class="shell section-standard">
    <p class="text-micro">Selected work</p>
    <h1 class="text-display-l font-editorial" style="margin-top: var(--space-3);">From architecture to decision.</h1>
    <p class="text-body-l reading-column">
      Projects are documented as decision records: the question, the evidence, the method and the result. Confidential
      work appears only at an approved level of abstraction.
    </p>

    {allWork.length === 0 ? (
      <p class="text-body" style="margin-top: var(--space-6);">
        No public case has been released in this version of the portal. See <a href="/research/">Research</a> or
        <a href="/teaching/"> Teaching</a> instead.
      </p>
    ) : (
      <div style="margin-top: var(--space-8);">
        <WorkSplit items={rows.slice(0, 4)} language={language} />
      </div>
    )}
  </section>
</BaseLayout>
