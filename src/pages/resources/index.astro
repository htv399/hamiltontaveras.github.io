---
// PG-RESOURCES. Intro is always required; grouped resources and filters
// appear only once eligible public resources exist (05-page-contracts.yml
// empty_state: "Show only intro and license policy link. Hide filters.").
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceLinks from "../../components/resources/ResourceLinks.astro";
import { getCollection } from "astro:content";
import { isEligible } from "../../lib/contentGate";
import { siteConfig } from "../../config/site";

const language = "en" as const;
const materials = (await getCollection("materials")).filter((e) => isEligible(e.data, siteConfig.env));
const resources = materials.map((m) => ({
  id: m.data.id,
  label: m.data.title,
  kind: m.data.material_type,
  href: m.data.href,
  access: m.data.access,
  license: m.data.license,
  format: m.data.material_type,
  file_size_bytes: m.data.file_size_bytes,
  version: m.data.version
}));
---
<BaseLayout title={`Resources — ${siteConfig.name}`} description="Public resources: data, code, teaching materials and downloadable documents." path="/resources/" language={language}>
  <section class="shell section-standard">
    <p class="text-body-l reading-column">
      Public resources referenced from Work, Research and Teaching are gathered here with their format, version,
      license and access conditions. A missing license is never treated as permission to reuse a file.
    </p>

    {resources.length > 0 ? (
      <div style="margin-top: var(--space-8);">
        <ResourceLinks resources={resources} variant="grouped" siteEnv={siteConfig.env} />
      </div>
    ) : null}

    <p class="text-small" style="margin-top: var(--space-6);">
      See the <a href="/licenses/">licenses and reuse policy</a> before reusing anything published here.
    </p>
  </section>
</BaseLayout>
