---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site";
import { platformContent } from "../../config/platform";
import { isEligible } from "../../lib/contentGate";

const language = "en" as const;
const products = (await getCollection("impactProducts")).filter((entry) => isEligible({ status: entry.data.status, access: entry.data.access_level }, siteConfig.env));
---
<BaseLayout title={`Impact Products — ${siteConfig.name}`} description={platformContent.impact.summary} path="/impact-products/" language={language}>
  <header class="impact-intro surface-paper">
    <div class="shell impact-intro__inner">
      <p class="text-micro">CaribbeanQuant</p>
      <h1>Impact Products</h1>
      <p class="text-body-l">{platformContent.impact.summary}</p>
    </div>
  </header>
  {products.length > 0 && (
    <section class="shell section-standard impact-list" aria-label="Published impact products">
      {products.map((product) => (
        <article>
          <p class="text-micro">{product.data.language.toUpperCase()} · {product.data.status} · v{product.data.version}</p>
          <h2 class="font-editorial"><a href={`/impact-products/${product.data.slug}/`}>{product.data.title}</a></h2>
          <p>{product.data.summary}</p>
        </article>
      ))}
    </section>
  )}
</BaseLayout>

<style>
  .impact-intro__inner { padding-block: var(--space-9); max-width: 980px; }
  .impact-intro h1 { margin-top: var(--space-3); font-size: var(--size-h1); }
  .impact-intro .text-body-l { margin-top: var(--space-5); max-width: 64ch; }
  .impact-list article { display: grid; grid-template-columns: 3fr 4fr 5fr; gap: var(--space-5); padding-block: var(--space-6); border-top: var(--border-strong); }
  @media (max-width: 768px) { .impact-intro__inner { padding-block: var(--space-8); } .impact-list article { grid-template-columns: 1fr; gap: var(--space-3); } }
</style>
